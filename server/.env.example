# ProofFlow Server Environment Variables
# Copy this file to .env and fill in real values

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/proofflow

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Cookie
COOKIE_DOMAIN=localhost

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Scheduler
SCHEDULER_INTERVAL_SECONDS=60

# Seed
SEED_DEFAULT_PASSWORD=CHANGE_ME_SEED_PASSWORD

# AI (SHOULD HAVE - optional)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
